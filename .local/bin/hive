#!/usr/bin/env bash

# Foreman-lite for herdr. Parses a Procfile and runs each process in its own
# pane, evenly stacked in a new tab of the current herdr workspace.
#
# Usage: hive [KEY=VALUE]... [Procfile]

set -euo pipefail

env_args=()
while [[ ${1:-} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
  env_args+=(--env "$1")
  shift
done

procfile=${1:-Procfile}

[ "${HERDR_ENV:-}" = 1 ] || { echo "hive: not inside a herdr session" >&2; exit 1; }
[ -f "$procfile" ] || { echo "hive: $procfile not found" >&2; exit 1; }

names=()
commands=()
while IFS= read -r line; do
  if [[ $line =~ ^([A-Za-z0-9_-]+):[[:space:]]*(.+)$ ]]; then
    names+=("${BASH_REMATCH[1]}")
    commands+=("${BASH_REMATCH[2]}")
  fi
done < "$procfile"

count=${#names[@]}
(( count > 0 )) || { echo "hive: no processes found in $procfile" >&2; exit 1; }

label=$(herdr tab get "$HERDR_TAB_ID" | jq -r '.result.tab.label')

tab=$(
  herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$PWD" \
    --label "hive: $label" --no-focus "${env_args[@]:0}"
)
tab_id=$(jq -r '.result.tab.tab_id' <<< "$tab")
pane=$(jq -r '.result.root_pane.pane_id' <<< "$tab")

# Place the new tab right after the current one instead of last. The CLI
# doesn't expose tab.move, so call the socket API directly.
index=$(
  herdr tab list --workspace "$HERDR_WORKSPACE_ID" |
    jq --arg tab "$HERDR_TAB_ID" '.result.tabs | map(.tab_id) | index($tab) + 1'
)
printf '{"id":"hive","method":"tab.move","params":{"tab_id":"%s","insert_index":%d}}\n' \
  "$tab_id" "$index" | nc -U "$HERDR_SOCKET_PATH" > /dev/null

for ((i = 0; i < count; i++)); do
  if (( i > 0 )); then
    ratio=$(awk -v k=$((count - i + 1)) 'BEGIN { printf "%.4f", 1 / k }')
    pane=$(
      herdr pane split --pane "$pane" --direction down --ratio "$ratio" \
        --cwd "$PWD" --no-focus "${env_args[@]:0}" |
        jq -r '.result.pane.pane_id'
    )
  fi

  command=${commands[i]//\'/\'\\\'\'}

  herdr pane rename "$pane" "${names[i]}" > /dev/null
  herdr pane run "$pane" "sh -c '$command'"
done

herdr tab focus "$tab_id" > /dev/null

echo "hive: started $count processes from $procfile"
