#!/usr/bin/env bash

# Foreman-lite for herdr. Parses a Procfile and runs each process in its own
# pane, evenly stacked in a new tab of the current herdr workspace.
#
# Usage: hive [Procfile]

set -euo pipefail

procfile=${1:-Procfile}

[ "${HERDR_ENV:-}" = 1 ] || { echo "hive: not inside a herdr session" >&2; exit 1; }
[ -f "$procfile" ] || { echo "hive: $procfile not found" >&2; exit 1; }

# A Procfile entry is `name: command`, same as foreman. Other lines are ignored.
names=()
commands=()
while IFS= read -r line; do
  if [[ $line =~ ^([A-Za-z0-9_-]+):[[:space:]]*(.+)$ ]]; then
    names+=("${BASH_REMATCH[1]}")
    commands+=("${BASH_REMATCH[2]}")
  fi
done < "$procfile"

count=${#names[@]}
(( count > 0 )) || { echo "hive: no processes found in $procfile" >&2; exit 1; }

tab=$(
  herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$PWD" \
    --label "hive: $(basename "$PWD")" --no-focus
)
pane=$(jq -r '.result.root_pane.pane_id' <<< "$tab")

for ((i = 0; i < count; i++)); do
  if (( i > 0 )); then
    # Split the last pane, keeping it one 1/N share of the tab so the final
    # layout comes out as an even vertical stack.
    ratio=$(awk -v k=$((count - i + 1)) 'BEGIN { printf "%.4f", 1 / k }')
    pane=$(
      herdr pane split --pane "$pane" --direction down --ratio "$ratio" \
        --cwd "$PWD" --no-focus |
        jq -r '.result.pane.pane_id'
    )
  fi

  command=${commands[i]//\'/\'\\\'\'}

  herdr pane rename "$pane" "${names[i]}" > /dev/null
  herdr pane run "$pane" "sh -c '$command'"
done

# Only jump to the tab once every pane is split and running.
herdr tab focus "$(jq -r '.result.tab.tab_id' <<< "$tab")" > /dev/null

echo "hive: started $count processes from $procfile"
